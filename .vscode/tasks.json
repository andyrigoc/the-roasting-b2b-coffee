{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start The Roasting locally",
      "type": "shell",
      "command": "npm run dev -- --logLevel info",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "http://127\\.0\\.0\\.1:5173/"
        }
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
